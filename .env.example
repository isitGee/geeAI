# ---------------------------------------------------------------------------
# GeeAI — server-side environment variables.
#
# Every value here is read by the serverless functions in /api.
# None of them are ever sent to the browser.
#
# Copy this file to .env for local development:  cp .env.example .env
# (.env is git-ignored; never commit a real key.)
# ---------------------------------------------------------------------------

# Which AI provider /api/chat talks to.
# Supported: gemini (default), echo (development self-test, no key needed).
AI_PROVIDER=gemini

# --- Google Gemini -----------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Required when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional. Must be one of the allowlisted models below.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Comma-separated allowlist of models the client may request.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-3.5-flash,gemini-3.8-flash

# Optional. Override only if you proxy the Gemini API (used for local testing).
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Limits (all optional) ---------------------------------------------------
# Upstream request timeout in milliseconds.
AI_REQUEST_TIMEOUT_MS=55000

# Per-IP request budget per minute (best-effort, per serverless instance).
AI_RATE_LIMIT_PER_MINUTE=30
